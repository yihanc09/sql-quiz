SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key

# Read-only student SQL connection; never use an admin role here.
QUIZ_DATABASE_URL=postgresql://quiz_reader:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Trusted backend connection for audit writes, migrations, and instructor checks.
# Keep this secret on the Python backend; never include it in frontend files.
DATABASE_URL=postgresql://YOUR_ADMIN_USER:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
