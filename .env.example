# Session-mode Supabase pooler (port 5432); omit its password from the URL.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF@YOUR_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_PASSWORD=your_supabase_database_password

# Run python -m scripts.admin.configure_runtime --init once from the original configured checkout.
# Other application settings live in the backend-only quiz_private schema.

# Optional local Chroma retrieval (no API key required).
# Relative paths resolve from the repository root. Do not use local storage on Vercel.
CHROMA_LOCAL_PATH=.chroma
CHROMA_COLLECTION=chinook_knowledge_minilm_v1

# OpenAI Responses API (backend only; never put this key in frontend code).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Chroma backend: local for development, cloud for deployment.
CHROMA_MODE=local
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_HOST=api.trychroma.com
CHROMA_CLOUD_COLLECTION=chinook_knowledge_openai3small_v1
